{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/app/admin-api/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/(payload)/api/**/*.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  }
}
