# Copy to .env and fill in. Never commit .env itself.

# Postgres. On the VPS this is the "Postgres URL (internal)" shown on the
# theoneroof-db page in Coolify. Locally, any Postgres you run yourself.
DATABASE_URL=postgresql://postgres:password@localhost:5432/theoneroof

# Any long random string. It signs logins; changing it signs everyone out.
PAYLOAD_SECRET=

# Only for `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=The One Roof
